<?xml version="1.0" encoding="UTF-8"?>
<test-data
    xmlns="http://pmd.sourceforge.net/rule-tests"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/rule-tests http://pmd.sourceforge.net/rule-tests_1_0_0.xsd">

    <test-code>
        <description>When CSS scripts are loaded from a CDN using &lt;apex:stylesheet&gt;, then report a violation</description>
        <expected-problems>3</expected-problems>
        <expected-linenumbers>2,3,4</expected-linenumbers>
        <code><![CDATA[
<apex:page controller="VFFutureMethodCtrl" >
    <apex:stylesheet value="https://something.example.com/styles.css"/>
    <apex:stylesheet value="https://something.example.com/{!myvar}.css"/>
    <apex:stylesheet value="{!cssUrl}"/>
    <apex:stylesheet value="{!URLFOR($Resource.myresource, 'something/css/something.css')}"/>
    <apex:stylesheet value="{!$Resource.mycss}"/>
</apex:page>
 ]]></code>
 </test-code>
</test-data>
